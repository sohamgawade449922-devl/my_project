# NeuralCommander – Environment Variables
# Copy this file to .env and fill in real values.

# ──────────────────────────────
# App
# ──────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false

# ──────────────────────────────
# Database (PostgreSQL + pgvector)
# ──────────────────────────────
DATABASE_URL=postgresql+asyncpg://neural:neural@db:5432/neuralcommander
SYNC_DATABASE_URL=postgresql://neural:neural@db:5432/neuralcommander

# ──────────────────────────────
# Redis
# ──────────────────────────────
REDIS_URL=redis://redis:6379/0

# ──────────────────────────────
# Google OAuth2 (Classroom)
# ──────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ──────────────────────────────
# OpenAI (optional LLM fallback)
# ──────────────────────────────
OPENAI_API_KEY=sk-...
